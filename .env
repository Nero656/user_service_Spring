# Services
EUREKA_IMAGE=eureka-server:latest
EUREKA_PORT=8761
USER_SERVICE_IMAGE=user-service:latest
NOTIFICATION_SERVICE_IMAGE=notification-service:latest
GATEWAY_IMAGE=gateway-service:latest
