# Config Server
CONFIG_SERVER_IMAGE=config-server:latest
CONFIG_SERVER_PORT=8888
CONFIG_ENABLED=true
CONFIG_ENCRYPT_KEY=9c474abb-14d3-4b52-a3c7-2eda16d760dc
SPRING_PROFILE=native

# Database
POSTGRES_USER=Nero
POSTGRES_PASSWORD=0907
POSTGRES_PORT=5432
USERS_DB_NAME=users_db
NOTIFICATION_DB_PORT=5433
